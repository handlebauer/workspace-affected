{
	"name": "workspace-affected",
	"version": "0.1.3",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/handlebauer/workspace-affected.git"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		}
	},
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"bin": {
		"workspace-affected": "dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"bump": "bunx bumpp --no-verify",
		"check": "bun scripts/workspace/check",
		"prepare": "husky",
		"release": "bun run publish.ts",
		"test": "bun test src/"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/bun": "latest",
		"colorette": "^2.0.20",
		"eslint-plugin-jsdoc": "^62.7.1",
		"husky": "^9.1.7",
		"jscpd": "^4.0.8",
		"knip": "^5.86.0",
		"lint-staged": "^16.3.2",
		"oxfmt": "^0.36.0",
		"oxlint": "^1.51.0",
		"sort-package-json": "^3.6.1",
		"tsdown": "^0.21.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
